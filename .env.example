# AI Trust Practice (server-only; never prefixed with VITE_, never exposed to the browser).
# Set these in Vercel for Production and Preview. For local development copy to .env.local.

# Shared password for people. Rotating it ends every existing session.
PRACTICE_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -base64 48`.
PRACTICE_SESSION_SECRET=
# Shared key for agents (X-Practice-Key header). At least 24 characters; rotate quarterly and on any leak.
PRACTICE_AGENT_KEY=

# Build-time access to the private content repository (fine-grained token, contents read-only).
PRACTICE_CONTENT_TOKEN=
# Optional overrides: PRACTICE_CONTENT_REPO=9to5ai/ai-trust-practice, PRACTICE_CONTENT_REF=main,
# PRACTICE_CONTENT_DIR=../ai-trust-practice-content, PRACTICE_INCLUDE_DRAFTS=1

# Optional: shared rate limits across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
