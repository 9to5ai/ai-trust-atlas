# Ask the Atlas — server-side only. Copy to .env for local development and set
# the same variables in Vercel project settings. Never prefix these with VITE_.

# Provider: gemini (default when GEMINI_API_KEY is set), vertex, or mock (keyless demo).
# ASK_PROVIDER=gemini
# Use a billing-enabled Google AI Studio project: free-tier prompts may be used to improve Google products.
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for current model IDs.
GEMINI_MODEL=gemini-3.8-flash

# Vertex AI instead of AI Studio (Australian data residency):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=australia-southeast1

# Guardrails
ASK_ENABLED=true
ASK_LIMIT_PER_MINUTE=8
ASK_LIMIT_PER_DAY=60
ASK_DAILY_TOKEN_BUDGET=2000000
# Shared limits across serverless instances (Vercel Marketplace → Upstash Redis):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
